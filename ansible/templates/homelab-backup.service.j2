[Unit]
Description=HomeLab & ACASH Automated Backup Service (E3.6 WS10 / O5)
Documentation=file:///data/docker/scripts/automation/README.md
After=network.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/data
ExecStart=/bin/bash /data/docker/scripts/automation/auto_backup.sh
StandardOutput=journal
StandardError=journal
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
